# Django Core Auth origin. Use HTTPS outside local development.
AUTH_ORIGIN=https://auth.naturalfarmingvietnam.com
# Exact public origin of this admin app; also used as the OAuth callback origin.
ADMIN_ORIGIN=http://localhost:3001
# Confidential OAuth client credentials. These variables are server-only.
ADMIN_OAUTH_CLIENT_ID=
ADMIN_OAUTH_CLIENT_SECRET=
# Generate at least 32 random characters, for example with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=
