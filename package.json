  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
